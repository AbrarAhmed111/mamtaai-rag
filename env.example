# ==============================================================================
# LLM FastAPI Backend Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME=LLM FastAPI Backend
ENVIRONMENT=development
API_VERSION=1.0.0
PORT=8000
BASE_URL=http://localhost:8000

# CORS Configuration
# Use * for open access, or comma-separated origins: http://localhost:3000,https://myfrontend.com
ALLOWED_ORIGINS=*

# ==============================================================================
# LLM Provider Configuration (Universal OpenAI-Compatible Standard)
# ==============================================================================
# Works with OpenAI, Groq, DeepSeek, Ollama, OpenRouter, vLLM, Together AI, etc.

# 1. Default (OpenAI)
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 2. Preset: Groq (Ultra-fast inference)
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_DEFAULT_MODEL=llama-3.3-70b-versatile

# 3. Preset: DeepSeek
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_DEFAULT_MODEL=deepseek-chat

# 4. Preset: Ollama (Local & Free)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_DEFAULT_MODEL=llama3.2

# 5. Preset: OpenRouter (Access 200+ models)
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Embeddings (for semantic search & RAG)
EMBEDDING_MODEL=text-embedding-3-small
